# Server Port (Render automatically sets PORT in production)
PORT=8080
SERVER_HOST=0.0.0.0

# PostgreSQL connection string
DATABASE_URL=postgresql://notesuser:notespass@localhost:5432/notesapp?sslmode=disable

# JWT Security
JWT_SECRET=super_secret_jwt_key_min_32_characters_long_for_security
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated list or * for all)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://angular-frontend-for-rust-backend-n.vercel.app

# Database Connection Pool & Bcrypt Settings
MAX_CONNECTIONS=50
BCRYPT_COST=10
RUST_LOG=info,tower_http=info
