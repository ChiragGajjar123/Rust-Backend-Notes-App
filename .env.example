PORT=8080

DATABASE_URL=postgresql://notesuser:NotesAppSecurePass123@127.0.0.1:5432/notesdb

JWT_SECRET=secretKeyNotesAppJWTSecretTokenGeneratorCustomString1234567890!
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://main.d3jqv6bft0m3qf.amplifyapp.com
MAX_CONNECTIONS=20
BCRYPT_COST=10
RUST_LOG=info,tower_http=info

# AWS SES Configuration for Password Reset Emails
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SES_FROM_EMAIL=noreply@yourdomain.com

# Password Reset Time-Interval Rate Limiting & Expiry
PASSWORD_RESET_INTERVAL_SECS=60
PASSWORD_RESET_EXPIRATION_MINS=15
