PORT=8080

# Neon Postgres connection string (Dashboard → Connection Details → URI)
# Example:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Optional alias for DATABASE_URL
# NEON_DATABASE_URL=

# Local Postgres without TLS (development only):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/notes_app_db?sslmode=disable

JWT_SECRET=secretKeyNotesAppJWTSecretTokenGeneratorCustomString1234567890!
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGIN=http://localhost:5173
MAY_WORKERS=8
